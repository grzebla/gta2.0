# Asset-free tests of the capture-directory handling in cmake/RunRenderCheck.cmake (CTest
# rendercheck.capture.<CASE>). FakeRenderer.cmake stands in for gta2, GTA20_GAME_DIR points at an
# empty SYNTHETIC directory, and the "checkout" and "build tree" being protected are synthetic
# directories in a fresh temporary work directory outside the real checkout (removed at the end).
# Inputs: CASE, RENDER_CHECK, FAKE_RENDERER, and for configured-default: CONFIGURED_ROOT,
# CHECKOUT_DIR, BUILD_DIR (the real ones; nothing is written there).
cmake_minimum_required(VERSION 3.25)
get_filename_component(cmake_dir "${RENDER_CHECK}" DIRECTORY)
include(${cmake_dir}/RenderCapture.cmake)

if(CASE STREQUAL "configured-default")
    # Validation only: the configured root used by gamedata.render.* is outside this checkout.
    gta20_render_capture_validate("${CONFIGURED_ROOT}" "${CHECKOUT_DIR}" "${BUILD_DIR}")
    message("configured capture root accepted: ${CONFIGURED_ROOT}")
    return()
endif()

foreach(var TMPDIR TEMP TMP)
    if(NOT "$ENV{${var}}" STREQUAL "")
        set(temp_base "$ENV{${var}}")
        break()
    endif()
endforeach()
if(NOT temp_base)
    set(temp_base "/tmp")
endif()
file(TO_CMAKE_PATH "${temp_base}" temp_base)
string(RANDOM LENGTH 8 ALPHABET "0123456789abcdefghijklmnopqrstuvwxyz" token)
set(work "${temp_base}/gta20-capture-test-${CASE}-${token}")
gta20_render_capture_validate("${work}" "${CHECKOUT_DIR}" "${BUILD_DIR}") # temp must be external
set(checkout "${work}/checkout")
set(build "${work}/build")
file(MAKE_DIRECTORY "${checkout}/build" "${build}" "${work}/synthetic-game")
file(WRITE "${checkout}/README.txt" "SYNTHETIC checkout\n")
set(failures "")

# Runs RunRenderCheck.cmake against the synthetic checkout. Sets <prefix>_rc, <prefix>_out
# (stdout + stderr) and <prefix>_calls (renderer invocations during this run).
function(render_check prefix root district)
    cmake_parse_arguments(A "" "MODE;CHECKOUT;BUILD" "" ${ARGN})
    if(NOT A_MODE)
        set(A_MODE ok)
    endif()
    if(NOT A_CHECKOUT)
        set(A_CHECKOUT "${checkout}")
    endif()
    if(NOT A_BUILD)
        set(A_BUILD "${build}")
    endif()
    set(log "${work}/renderer-calls.log")
    file(REMOVE "${log}")
    set(ENV{FAKE_RENDER_LOG} "${log}")
    set(ENV{FAKE_RENDER_MODE} "${A_MODE}")
    execute_process(COMMAND ${CMAKE_COMMAND} "-DGTA2_EXE=${CMAKE_COMMAND};-P;${FAKE_RENDERER}"
                            "-DLEVEL=data/${district}.gmp" "-DCAPTURE_ROOT=${root}"
                            "-DCHECKOUT_DIR=${A_CHECKOUT}" "-DBUILD_DIR=${A_BUILD}" -P "${RENDER_CHECK}"
                    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE out)
    set(calls 0)
    if(EXISTS "${log}")
        file(STRINGS "${log}" lines)
        list(LENGTH lines calls)
    endif()
    set(${prefix}_rc "${rc}" PARENT_SCOPE)
    set(${prefix}_out "${out}" PARENT_SCOPE)
    set(${prefix}_calls "${calls}" PARENT_SCOPE)
endfunction()

macro(fail what)
    list(APPEND failures "${what}")
endmacro()

# The run passed and left exactly one capture, <root>/<run>/render-<district>.bmp, whose path it
# reported. Sets <prefix>_file.
macro(expect_capture prefix root district)
    set(${prefix}_file "")
    if(NOT ${prefix}_rc EQUAL 0 OR NOT ${prefix}_calls EQUAL 1)
        fail("${prefix}: expected a passing run with one renderer call, got rc=${${prefix}_rc} calls=${${prefix}_calls}:\n${${prefix}_out}")
    else()
        string(REGEX MATCH "Render capture saved: ([^\n]*)" _ "${${prefix}_out}")
        set(${prefix}_file "${CMAKE_MATCH_1}")
        get_filename_component(_name "${${prefix}_file}" NAME)
        get_filename_component(_run "${${prefix}_file}" DIRECTORY)
        get_filename_component(_parent "${_run}" DIRECTORY)
        get_filename_component(_run "${_run}" NAME)
        file(TO_CMAKE_PATH "${root}" _root)
        set(_d "[0-9]")
        set(_c "[0-9a-z]")
        set(_run_pattern "^${_d}${_d}${_d}${_d}${_d}${_d}${_d}${_d}T${_d}${_d}${_d}${_d}${_d}${_d}Z-${district}-")
        string(APPEND _run_pattern "${_c}${_c}${_c}${_c}${_c}${_c}${_c}${_c}$")
        if(NOT EXISTS "${${prefix}_file}" OR NOT _name STREQUAL "render-${district}.bmp"
           OR NOT _parent STREQUAL _root OR NOT _run MATCHES "${_run_pattern}")
            fail("${prefix}: unexpected capture '${${prefix}_file}' (root '${_root}'):\n${${prefix}_out}")
        endif()
    endif()
endmacro()

# The run failed before invoking the renderer, with a message matching `pattern`, and did not
# create `root`.
macro(expect_rejected prefix root pattern)
    if(${prefix}_rc EQUAL 0 OR NOT ${prefix}_calls EQUAL 0 OR NOT ${prefix}_out MATCHES "${pattern}")
        fail("${prefix}: expected rejection '${pattern}' before the renderer, got rc=${${prefix}_rc} calls=${${prefix}_calls}:\n${${prefix}_out}")
    endif()
    if(EXISTS "${root}")
        fail("${prefix}: rejected destination '${root}' was created")
    endif()
endmacro()

set(ENV{GTA20_GAME_DIR} "${work}/synthetic-game")
unset(ENV{G2N_GAME_DIR})
unset(ENV{GTA20_RENDER_CAPTURE_DIR})

if(CASE STREQUAL "accepted-external")
    render_check(run "${work}/captures" wil)
    expect_capture(run "${work}/captures" wil)
    if(NOT run_out MATCHES "Render capture \\(original data - local only, do not commit or upload\\): ")
        fail("the output path must be reported before rendering:\n${run_out}")
    endif()
elseif(CASE STREQUAL "rejects-checkout")
    render_check(inside "${checkout}/captures" wil)
    expect_rejected(inside "${checkout}/captures" "inside the checkout")
    render_check(root "${checkout}" wil)
    expect_rejected(root "${work}/never-created" "inside the checkout")
    render_check(dotdot "${work}/captures/../checkout/captures" wil)
    expect_rejected(dotdot "${checkout}/captures" "inside the checkout")
    render_check(nested_build "${checkout}/build/tests/conformance" ste)
    expect_rejected(nested_build "${checkout}/build/tests" "inside the checkout")
elseif(CASE STREQUAL "rejects-build")
    # A build tree outside the checkout is protected as well.
    render_check(inside "${build}/tests/conformance" bil)
    expect_rejected(inside "${build}/tests" "inside the build tree")
    render_check(trailing "${build}/" bil)
    expect_rejected(trailing "${build}/tests" "inside the build tree")
elseif(CASE STREQUAL "path-with-spaces")
    set(root "${work}/capture dir with spaces/run s")
    render_check(run "${root}" ste)
    expect_capture(run "${root}" ste)
elseif(CASE STREQUAL "repeated-runs")
    render_check(first "${work}/captures" wil)
    expect_capture(first "${work}/captures" wil)
    render_check(second "${work}/captures" wil)
    expect_capture(second "${work}/captures" wil)
    render_check(other "${work}/captures" ste)
    expect_capture(other "${work}/captures" ste)
    set(files "${first_file}" "${second_file}" "${other_file}")
    list(REMOVE_DUPLICATES files)
    list(LENGTH files distinct)
    if(NOT distinct EQUAL 3 OR NOT EXISTS "${first_file}" OR NOT EXISTS "${second_file}")
        fail("repeated runs must keep independent captures: ${first_file} ${second_file} ${other_file}")
    endif()
elseif(CASE STREQUAL "symlinks")
    file(MAKE_DIRECTORY "${work}/outside" "${checkout}/existing")
    file(CREATE_LINK "${checkout}" "${work}/to-checkout" RESULT link_rc SYMBOLIC)
    if(NOT link_rc STREQUAL "0")
        file(REMOVE_RECURSE "${work}")
        message("SKIP: symbolic links unavailable on this host: ${link_rc}")
        return()
    endif()
    file(CREATE_LINK "${checkout}/existing" "${work}/to-existing" SYMBOLIC)
    file(CREATE_LINK "${work}/outside" "${checkout}/out-link" SYMBOLIC)
    file(CREATE_LINK "${work}/outside" "${work}/to-outside" SYMBOLIC)
    file(CREATE_LINK "${checkout}/not-yet" "${work}/dangling" SYMBOLIC)
    # Existing symlink resolving into the checkout, with and without a missing tail.
    render_check(via_parent "${work}/to-checkout/captures" wil)
    expect_rejected(via_parent "${checkout}/captures" "inside the checkout")
    render_check(link_itself "${work}/to-existing" wil)
    expect_rejected(link_itself "${checkout}/existing/x" "inside the checkout")
    file(GLOB existing_content "${checkout}/existing/*")
    if(existing_content)
        fail("link_itself: wrote into the checkout: ${existing_content}")
    endif()
    # A link inside the checkout is rejected even though it points outside.
    render_check(link_in_checkout "${checkout}/out-link/captures" wil)
    expect_rejected(link_in_checkout "${work}/outside/captures" "inside the checkout")
    # The same when the checkout itself is named through a symlink (e.g. /tmp on macOS).
    render_check(checkout_via_link "${checkout}/out-link/captures" wil CHECKOUT "${work}/to-checkout")
    expect_rejected(checkout_via_link "${work}/outside/captures" "inside the checkout")
    # A dangling link cannot be verified.
    render_check(dangling "${work}/dangling/captures" wil)
    expect_rejected(dangling "${checkout}/not-yet" "dangling symbolic link")
    # Control: a link to an external directory is fine; the capture lands at its target.
    render_check(external "${work}/to-outside/captures" bil)
    expect_capture(external "${work}/to-outside/captures" bil)
    file(GLOB_RECURSE at_target "${work}/outside/captures/*/render-bil.bmp")
    if(NOT at_target)
        fail("external: capture not found below the link target ${work}/outside")
    endif()
elseif(CASE STREQUAL "not-configured")
    render_check(empty "" wil)
    expect_rejected(empty "${checkout}/build/tests/conformance" "No render capture directory configured")
    render_check(relative "captures" wil)
    expect_rejected(relative "${work}/captures" "is not an absolute path")
elseif(CASE STREQUAL "env-override")
    set(ENV{GTA20_RENDER_CAPTURE_DIR} "${work}/env-captures")
    render_check(env "${checkout}/configured" wil)
    expect_capture(env "${work}/env-captures" wil)
    if(EXISTS "${checkout}/configured")
        fail("env: the overridden configured root was created")
    endif()
    # An invalid override fails; it does not fall back to the configured root.
    set(ENV{GTA20_RENDER_CAPTURE_DIR} "${checkout}/env-bad")
    render_check(bad_env "${work}/configured" wil)
    expect_rejected(bad_env "${checkout}/env-bad" "inside the checkout")
    if(EXISTS "${work}/configured")
        fail("bad_env: fell back to the configured root")
    endif()
    unset(ENV{GTA20_RENDER_CAPTURE_DIR})
elseif(CASE STREQUAL "missing-data")
    # Without game data the check skips first, exactly as before, whatever the destination.
    unset(ENV{GTA20_GAME_DIR})
    foreach(root "${work}/captures" "${checkout}/captures")
        render_check(run "${root}" wil)
        if(NOT run_rc EQUAL 0 OR NOT run_calls EQUAL 0 OR NOT run_out MATCHES "SKIP: GTA20_GAME_DIR not set"
           OR EXISTS "${root}")
            fail("missing data must skip without touching '${root}': rc=${run_rc} calls=${run_calls}:\n${run_out}")
        endif()
    endforeach()
    set(ENV{GTA20_GAME_DIR} "")
    set(ENV{G2N_GAME_DIR} "${work}/synthetic-game") # legacy name still honoured
    render_check(legacy "${work}/legacy" wil)
    expect_capture(legacy "${work}/legacy" wil)
elseif(CASE STREQUAL "gpu-skip")
    render_check(run "${work}/captures" wil MODE nogpu)
    if(NOT run_rc EQUAL 0 OR NOT run_calls EQUAL 1 OR NOT run_out MATCHES "SKIP: no GPU device")
        fail("missing GPU must skip: rc=${run_rc} calls=${run_calls}:\n${run_out}")
    endif()
    file(GLOB leftovers LIST_DIRECTORIES true "${work}/captures/*")
    if(leftovers)
        fail("skipped run left files behind: ${leftovers}")
    endif()
elseif(CASE STREQUAL "thresholds")
    render_check(run "${work}/captures" wil MODE blank)
    if(run_rc EQUAL 0 OR NOT run_out MATCHES "only 1 distinct colours")
        fail("a blank frame must fail the image thresholds: rc=${run_rc}:\n${run_out}")
    endif()
else()
    fail("unknown CASE '${CASE}'")
endif()

# No case may leave anything in the synthetic checkout or build tree.
file(GLOB_RECURSE in_tree LIST_DIRECTORIES true "${checkout}/*" "${build}/*")
list(REMOVE_ITEM in_tree "${checkout}/README.txt" "${checkout}/build" "${checkout}/existing" "${checkout}/out-link")
if(in_tree)
    fail("files or directories written into the synthetic checkout or build tree: ${in_tree}")
endif()

file(REMOVE_RECURSE "${work}")
if(failures)
    list(JOIN failures "\n" text)
    message(FATAL_ERROR "${text}")
endif()
message("rendercheck.capture.${CASE}: ok")

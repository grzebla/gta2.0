# Asset-free tests of cmake/RunConformance.cmake (CTest conformance.wrapper.<CASE>).
# FakeHeadless.cmake stands in for gta20-headless; scenario, traces and golden are SYNTHETIC files
# in WORK_ROOT, a scratch directory of this test that is recreated on every run.
# Inputs: CASE, WRAPPER, FAKE_HEADLESS, WORK_ROOT.
cmake_minimum_required(VERSION 3.25)

file(REMOVE_RECURSE "${WORK_ROOT}")
set(work "${WORK_ROOT}/work")
set(scenario "${WORK_ROOT}/synthetic-scenario.json")
set(golden "${WORK_ROOT}/synthetic.golden.jsonl")
set(trace "{\"synthetic\":true,\"tick\":0}\n") # what FakeHeadless.cmake writes for `ok`
file(MAKE_DIRECTORY "${work}")
file(WRITE "${scenario}" "{\"id\":\"synthetic-wrapper\",\"provenance\":\"synthetic\"}\n")
file(WRITE "${golden}" "${trace}")
set(failures "")

# Runs RunConformance.cmake with the fake headless whose run calls behave as `runs`. Sets
# <prefix>_rc, <prefix>_out (stdout + stderr) and <prefix>_calls (run calls during this run).
function(conformance prefix mode runs)
    set(log "${WORK_ROOT}/headless-calls.log")
    file(REMOVE "${log}")
    set(ENV{FAKE_HEADLESS_LOG} "${log}")
    set(ENV{FAKE_HEADLESS_RUNS} "${runs}")
    execute_process(COMMAND ${CMAKE_COMMAND} "-DHEADLESS=${CMAKE_COMMAND};-P;${FAKE_HEADLESS}"
                            "-DSCENARIO=${scenario}" "-DWORK=${work}" "-DMODE=${mode}" "-DGOLDEN=${golden}"
                            -P "${WRAPPER}"
                    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE out)
    set(calls 0)
    if(EXISTS "${log}")
        file(STRINGS "${log}" lines REGEX "^run ")
        list(LENGTH lines calls)
    endif()
    set(${prefix}_rc "${rc}" PARENT_SCOPE)
    set(${prefix}_out "${out}" PARENT_SCOPE)
    set(${prefix}_calls "${calls}" PARENT_SCOPE)
endfunction()

macro(fail what)
    list(APPEND failures "${what}")
endmacro()

# Leaves matching traces from an "earlier successful run" in the work directory.
macro(seed_stale_traces)
    file(WRITE "${work}/a.jsonl" "${trace}")
    file(WRITE "${work}/b.jsonl" "${trace}")
endmacro()

macro(expect_pass prefix calls)
    if(NOT ${prefix}_rc EQUAL 0 OR NOT ${prefix}_calls EQUAL ${calls})
        fail("${prefix}: expected a pass after ${calls} run(s), got rc=${${prefix}_rc} calls=${${prefix}_calls}:\n${${prefix}_out}")
    endif()
endmacro()

macro(expect_fail prefix calls pattern)
    if(${prefix}_rc EQUAL 0 OR NOT ${prefix}_calls EQUAL ${calls} OR NOT ${prefix}_out MATCHES "${pattern}")
        fail("${prefix}: expected failure '${pattern}' after ${calls} run(s), got rc=${${prefix}_rc} calls=${${prefix}_calls}:\n${${prefix}_out}")
    endif()
endmacro()

if(CASE STREQUAL "deterministic")
    conformance(fresh determinism "ok;ok")
    expect_pass(fresh 2)
    seed_stale_traces()
    conformance(rerun determinism "ok;ok")
    expect_pass(rerun 2)
    conformance(regression regression "ok")
    expect_pass(regression 1)
elseif(CASE STREQUAL "first-run-fails")
    conformance(fresh determinism "fail")
    expect_fail(fresh 1 "first run failed")
    seed_stale_traces()
    conformance(stale determinism "fail")
    expect_fail(stale 1 "first run failed")
    seed_stale_traces()
    conformance(regression regression "fail")
    expect_fail(regression 1 "first run failed")
elseif(CASE STREQUAL "second-run-fails")
    # A matching b.jsonl from an earlier run must not hide the failure.
    seed_stale_traces()
    conformance(stale determinism "ok;fail")
    expect_fail(stale 2 "second run failed")
    seed_stale_traces()
    conformance(wrote determinism "ok;wrote-fail")
    expect_fail(wrote 2 "second run failed")
elseif(CASE STREQUAL "missing-output")
    seed_stale_traces()
    conformance(first determinism "none;ok")
    expect_fail(first 1 "first run did not write")
    seed_stale_traces()
    conformance(second determinism "ok;none")
    expect_fail(second 2 "second run did not write")
    seed_stale_traces()
    conformance(regression regression "none")
    expect_fail(regression 1 "first run did not write")
elseif(CASE STREQUAL "differing-output")
    conformance(second determinism "ok;differ")
    expect_fail(second 2 "two runs produced different traces")
    conformance(first determinism "differ;ok")
    expect_fail(first 2 "two runs produced different traces")
    conformance(regression regression "differ")
    expect_fail(regression 1 "trace differs from golden")
elseif(CASE STREQUAL "unknown-mode")
    foreach(mode bogus Determinism "")
        conformance(mode "${mode}" "ok;ok")
        expect_fail(mode 0 "unknown MODE '${mode}'")
    endforeach()
else()
    fail("unknown CASE '${CASE}'")
endif()

file(REMOVE_RECURSE "${WORK_ROOT}")
if(failures)
    list(JOIN failures "\n" text)
    message(FATAL_ERROR "${text}")
endif()
message("conformance.wrapper.${CASE}: ok")

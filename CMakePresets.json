{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "FETCHCONTENT_BASE_DIR": "${sourceDir}/.deps" }
    },
    { "name": "debug", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "release", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "Debug + ASan/UBSan (Clang/GCC)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "G2N_SANITIZE": "ON" }
    },
    {
      "name": "headless",
      "inherits": "base",
      "displayName": "Simulation, assets and tests only - no SDL, no GPU",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "G2N_BUILD_APP": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "headless", "configurePreset": "headless" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } },
    { "name": "headless", "configurePreset": "headless", "output": { "outputOnFailure": true } }
  ]
}

# Capture directory for the original-data render checks (gamedata.render.*, see
# cmake/RunRenderCheck.cmake and docs/testing.md). Screenshots of real GTA 2 data must stay
# local: never in the checkout, never in the build tree, so never in CI artifacts.
# Usable from a project (default location) and from script mode (validation, run directories).

# Per-user cache directory outside any checkout: %LOCALAPPDATA%, $XDG_CACHE_HOME or ~/.cache,
# else the temporary directory.
function(gta20_render_capture_default out_var)
    if(CMAKE_HOST_WIN32 AND NOT "$ENV{LOCALAPPDATA}" STREQUAL "")
        set(base "$ENV{LOCALAPPDATA}")
    elseif(NOT CMAKE_HOST_WIN32 AND NOT "$ENV{XDG_CACHE_HOME}" STREQUAL "")
        set(base "$ENV{XDG_CACHE_HOME}")
    elseif(NOT CMAKE_HOST_WIN32 AND NOT "$ENV{HOME}" STREQUAL "")
        set(base "$ENV{HOME}/.cache")
    elseif(NOT "$ENV{TEMP}" STREQUAL "")
        set(base "$ENV{TEMP}")
    elseif(NOT "$ENV{TMPDIR}" STREQUAL "")
        set(base "$ENV{TMPDIR}")
    else()
        set(base "/tmp")
    endif()
    file(TO_CMAKE_PATH "${base}/gta20/render-captures" path)
    set(${out_var} "${path}" PARENT_SCOPE)
endfunction()

# Real path of `path` even when its tail does not exist yet: the deepest existing ancestor is
# resolved through symlinks, the missing components are appended. Sets <out_var>-NOTFOUND
# when a dangling symlink is on the way (its target cannot be judged before it is created).
function(_gta20_resolve_path path out_var)
    file(TO_CMAKE_PATH "${path}" head)
    string(REGEX REPLACE "(.)/+$" "\\1" head "${head}")
    set(tail "")
    while(NOT EXISTS "${head}")
        if(IS_SYMLINK "${head}")
            set(${out_var} "${out_var}-NOTFOUND" PARENT_SCOPE)
            return()
        endif()
        cmake_path(GET head FILENAME name)
        cmake_path(GET head PARENT_PATH parent)
        if(parent STREQUAL head OR name STREQUAL "")
            break()
        endif()
        set(tail "${name}/${tail}")
        set(head "${parent}")
    endwhile()
    if(EXISTS "${head}")
        file(REAL_PATH "${head}" head)
    endif()
    if(NOT tail STREQUAL "")
        cmake_path(APPEND head "${tail}")
    endif()
    cmake_path(SET resolved NORMALIZE "${head}")
    string(REGEX REPLACE "(.)/+$" "\\1" resolved "${resolved}")
    set(${out_var} "${resolved}" PARENT_SCOPE)
endfunction()

# TRUE when `path` equals or lies below `dir` (component-wise; case-insensitive on Windows and
# macOS, whose default file systems are).
function(_gta20_path_within path dir out_var)
    if(CMAKE_HOST_WIN32 OR CMAKE_HOST_APPLE)
        string(TOLOWER "${path}" path)
        string(TOLOWER "${dir}" dir)
    endif()
    cmake_path(IS_PREFIX dir "${path}" NORMALIZE within)
    set(${out_var} ${within} PARENT_SCOPE)
endfunction()

# Fails (FATAL_ERROR, actionable) unless `dir` is an absolute path outside `checkout_dir` and
# `build_dir`, both as written and after resolving symlinks in every existing ancestor.
function(gta20_render_capture_validate dir checkout_dir build_dir)
    set(hint "Set GTA20_RENDER_CAPTURE_DIR (CMake cache variable, or environment variable at test \
time) to an absolute directory outside the checkout and the build tree; see docs/testing.md.")
    if("${dir}" STREQUAL "")
        message(FATAL_ERROR "No render capture directory configured; refusing to fall back to the "
                            "build tree. ${hint}")
    endif()
    file(TO_CMAKE_PATH "${dir}" lexical)
    if(NOT IS_ABSOLUTE "${lexical}")
        message(FATAL_ERROR "Render capture directory '${dir}' is not an absolute path. ${hint}")
    endif()
    cmake_path(NORMAL_PATH lexical)
    _gta20_resolve_path("${dir}" resolved)
    if(NOT resolved)
        message(FATAL_ERROR "Render capture directory '${dir}' goes through a dangling symbolic "
                            "link; its destination cannot be verified. ${hint}")
    endif()
    # Every existing ancestor, resolved: catches symlinks anywhere on the path.
    set(candidates "${lexical}" "${resolved}")
    set(probe "${lexical}")
    while(TRUE)
        if(EXISTS "${probe}")
            file(REAL_PATH "${probe}" real)
            list(APPEND candidates "${real}")
        endif()
        cmake_path(GET probe PARENT_PATH parent)
        if(parent STREQUAL probe OR parent STREQUAL "")
            break()
        endif()
        set(probe "${parent}")
    endwhile()
    foreach(kind checkout build)
        set(protected "${${kind}_dir}")
        if("${protected}" STREQUAL "")
            message(FATAL_ERROR "Render capture check needs the ${kind} directory to protect it.")
        endif()
        file(TO_CMAKE_PATH "${protected}" protected)
        _gta20_resolve_path("${protected}" protected_real)
        foreach(candidate IN LISTS candidates)
            foreach(base "${protected}" "${protected_real}")
                if(NOT base)
                    continue()
                endif()
                _gta20_path_within("${candidate}" "${base}" within)
                if(within)
                    if(kind STREQUAL "checkout")
                        set(what "the checkout")
                    else()
                        set(what "the build tree")
                    endif()
                    message(FATAL_ERROR
                            "Render capture directory '${dir}' (resolves to '${resolved}') is "
                            "inside ${what} '${protected}'. Original-data screenshots must not be "
                            "written to the checkout, the build tree or CI artifacts. ${hint}")
                endif()
            endforeach()
        endforeach()
    endforeach()
endfunction()

# Validates `root` and creates a fresh run directory below it:
#   <root>/<UTC timestamp>-<district>-<8 random characters>
# Sets <out_var> to the new directory.
function(gta20_render_capture_prepare root checkout_dir build_dir district out_var)
    gta20_render_capture_validate("${root}" "${checkout_dir}" "${build_dir}")
    file(TO_CMAKE_PATH "${root}" root)
    cmake_path(NORMAL_PATH root)
    string(REGEX REPLACE "(.)/+$" "\\1" root "${root}")
    foreach(attempt RANGE 8)
        string(TIMESTAMP stamp "%Y%m%dT%H%M%SZ" UTC)
        string(RANDOM LENGTH 8 ALPHABET "0123456789abcdefghijklmnopqrstuvwxyz" token)
        set(run_dir "${root}/${stamp}-${district}-${token}")
        if(NOT EXISTS "${run_dir}" AND NOT IS_SYMLINK "${run_dir}")
            break()
        endif()
        set(run_dir "")
    endforeach()
    if(run_dir STREQUAL "")
        message(FATAL_ERROR "Could not pick an unused run directory below '${root}'.")
    endif()
    file(MAKE_DIRECTORY "${run_dir}")
    # Re-check the directory that now exists, in case the tree changed under us.
    gta20_render_capture_validate("${run_dir}" "${checkout_dir}" "${build_dir}")
    set(${out_var} "${run_dir}" PARENT_SCOPE)
endfunction()
